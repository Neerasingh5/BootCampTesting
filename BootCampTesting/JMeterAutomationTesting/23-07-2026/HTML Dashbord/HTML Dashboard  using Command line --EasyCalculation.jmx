              <url>true</url>
              <threadCounts>true</threadCounts>
              <idleTime>true</idleTime>
              <connectTime>true</connectTime>
            </value>
          </objProp>
          <stringProp name="filename">C:\JmeterPractiseExample\Assertion\HTML Dashbord\CSV file\ Result.csv</stringProp>
